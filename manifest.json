{
  "manifest_version": 3,
  "name": "AnthonyOS Website Viewer",
  "version": "0.1.0",
  "description": "Review AnthonyOS website opportunities in one browser tab.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://autotext-psi.vercel.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://autotext-psi.vercel.app/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://autotext-psi.vercel.app/*"
      ],
      "js": [
        "review-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open AnthonyOS website viewer"
  },
  "icons": {},
  "minimum_chrome_version": "114"
}