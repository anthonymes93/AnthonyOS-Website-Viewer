{
  "manifest_version": 3,
  "name": "AnthonyOS Website Viewer",
  "version": "0.2.0",
  "description": "Review AnthonyOS opportunities with persistent controls that work even on broken websites.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://autotext-psi.vercel.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://autotext-psi.vercel.app/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AnthonyOS Website Viewer",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "114"
}
